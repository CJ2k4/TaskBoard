# Copy to .env.local for local dev. Values here are safe placeholders only.

# Base URL of the Spring Boot backend, used by server-side fetches.
# Server-only (no NEXT_PUBLIC_ prefix) — never exposed to the browser bundle.
API_BASE_URL=http://localhost:8080

# Base URL of the backend for BROWSER-side auth calls (login/register/refresh/me).
# NEXT_PUBLIC_ means it ships to the client bundle — safe here, it's a public URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
