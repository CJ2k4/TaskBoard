# Copy to .env.local for local dev. Values here are safe placeholders only.

# Base URL of the backend. Every call is browser-side, so this is the only one needed.
# NEXT_PUBLIC_ means it ships to the client bundle — safe here, it's a public URL — but it
# is inlined at BUILD time, so changing it needs a rebuild, not a restart. No trailing slash.
# The same value doubles as the WebSocket origin: the STOMP client swaps http→ws (https→wss).
NEXT_PUBLIC_API_URL=http://localhost:8080

# OAuth 2.0 Web client ID from Google Cloud Console, for "Continue with Google".
# NEXT_PUBLIC_ (browser-side); public by nature. Must match the backend's GOOGLE_CLIENT_ID.
# Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
